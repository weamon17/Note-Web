{
    "name": "noteflow/noteflow",
    "description": "NoteFlow - Note Management Application",
    "type": "project",
    "require": {
        "php": ">=8.0",
        "phpmailer/phpmailer": "^6.9",
        "cboden/ratchet": "^0.4"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "config": {
